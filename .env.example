# Copy to .env (git-ignored) and fill in.

# --- Model provider -------------------------------------------------------------
# anthropic (default): the Claude API.
# openai: any OpenAI-compatible API - OpenAI, Gemini, OpenRouter, Groq, or a local
#         model through Ollama or LM Studio.
# CV_TAILOR_PROVIDER=anthropic

# Claude
ANTHROPIC_API_KEY=

# OpenAI-compatible (CV_TAILOR_PROVIDER=openai). Base URL examples:
#   OpenAI      https://api.openai.com/v1 (the default)
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter  https://openrouter.ai/api/v1
#   Groq        https://api.groq.com/openai/v1
#   Ollama      http://localhost:11434/v1   (no key needed)
#   LM Studio   http://localhost:1234/v1    (no key needed)
# CV_TAILOR_BASE_URL=
# CV_TAILOR_API_KEY=          (OPENAI_API_KEY also works)

# --- Models -----------------------------------------------------------------------
# Claude defaults: Haiku 5.5 for analyse/bullet/answer, Sonnet 5.5 for tailor/extras.
# Other providers have no defaults: set CV_TAILOR_MODEL (e.g. a model name from your provider).
# CV_TAILOR_MODEL sets every step; CV_TAILOR_MODEL_<STEP> sets one and wins over it.
# CV_TAILOR_MODEL=claude-opus-5-5
# CV_TAILOR_MODEL_ANALYSE=claude-haiku-5-5
# CV_TAILOR_MODEL_BULLET=claude-haiku-5-5
# CV_TAILOR_MODEL_ANSWER=claude-haiku-5-5
# CV_TAILOR_MODEL_TAILOR=claude-sonnet-5-5
# CV_TAILOR_MODEL_EXTRAS=claude-sonnet-5-5

# --- Other --------------------------------------------------------------------------
# Optional: where the application tracker keeps its SQLite database.
# CV_TAILOR_DB=data/cv_tailor.db
# Optional: use another profile file (end-to-end tests point this at a temp copy)
# CV_TAILOR_PROFILE=
