# CV Tailor settings. Copy this file to .env and set up ONE of the three options.
# Lines starting with # are ignored.


# --- Option 1: Claude (the default) ------------------------------------------
# This is the only line you need. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=


# --- Option 2: another provider (OpenAI, Gemini, OpenRouter, Groq...) ---------
# Remove the # from these four lines and fill them in.
# Base URLs for Gemini, OpenRouter and Groq are in the README.
# CV_TAILOR_PROVIDER=openai
# CV_TAILOR_BASE_URL=https://api.openai.com/v1
# CV_TAILOR_API_KEY=
# CV_TAILOR_MODEL=


# --- Option 3: a local model with Ollama (free, nothing leaves your computer) --
# Start Ollama, then remove the # from these three lines and add a model you have pulled.
# CV_TAILOR_PROVIDER=openai
# CV_TAILOR_BASE_URL=http://localhost:11434/v1
# CV_TAILOR_MODEL=


# --- Optional extras (skip these unless you need them) -------------------------
# A different model for one step (analyse, bullet, answer, tailor or extras):
# CV_TAILOR_MODEL_TAILOR=
# Keep your profile or tracker database somewhere else (defaults: data/profile.yaml, data/cv_tailor.db):
# CV_TAILOR_PROFILE=
# CV_TAILOR_DB=
