<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>{{ person.name }} Cover Letter</title>
<style>
/* Same type and header as cv.html.j2, so the letter and the CV look like a set. */
@page { size: A4; margin: 13mm 18mm 15mm 18mm; }
* { box-sizing: border-box; }
body { font-family: "Liberation Serif", "Times New Roman", serif; font-size: 11pt; line-height: 1.4; color: #000; margin: 0; }
a { color: #1a0dab; text-decoration: none; }
.head { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; margin-bottom: 6px;
        padding-bottom: 6px; border-bottom: 1px solid #000; }
.head .l { font-size: 9.5pt; line-height: 1.25; }
.head .r { text-align: right; font-size: 9.5pt; line-height: 1.25; }
.head h1 { font-size: 19pt; margin: 0; font-weight: bold; }
.date { text-align: right; margin: 14px 0 12px; }
.subject { font-weight: bold; margin: 0 0 12px; }
p { margin: 0 0 10px; text-align: justify; hyphens: auto; }
</style></head>
<body>

<div class="head">
  <div class="l">{% for x in left_lines %}{% if not loop.first %}<br>{% endif %}{{ x }}{% endfor %}</div>
  <h1>{{ person.name }}</h1>
  <div class="r">
    <a href="mailto:{{ person.email }}">{{ person.email }}</a>
    {%- if person.website %}<br><a href="{{ person.website }}">{{ person.website | replace('https://','') }}</a>{% endif %}
    {%- if person.linkedin %}<br><a href="{{ person.linkedin }}">{{ person.linkedin | replace('https://','') }}</a>{% endif %}
    {%- if person.github %}<br><a href="{{ person.github }}">{{ person.github | replace('https://','') }}</a>{% endif %}
  </div>
</div>

<div class="date">{{ date }}</div>
{% if subject %}<div class="subject">{{ subject }}</div>{% endif %}
{% for paragraph in paragraphs %}
<p>{% for line in paragraph %}{% if not loop.first %}<br>{% endif %}{{ line }}{% endfor %}</p>
{%- endfor %}

</body></html>
