<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>{{ person.name }} CV</title>
<style>
@page { size: A4; margin: {{ layout.margin_mm | default('13mm 15mm 11mm 15mm') }}; }
* { box-sizing: border-box; }
body { font-family: "Liberation Serif", "Times New Roman", serif; font-size: {{ layout.font_pt | default(10.5) }}pt; line-height: {{ layout.line_height | default(1.25) }}; color: #000; margin: 0; }
a { color: #1a0dab; text-decoration: none; }
.head { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; margin-bottom: 6px; }
.head .l { font-size: 9.5pt; }
.head .r { text-align: right; font-size: 9.5pt; }
.head h1 { font-size: 19pt; margin: 0; font-weight: bold; }
h2 { font-size: 11pt; margin: {{ layout.section_gap | default('9px') }} 0 3px; padding-bottom: 1px; border-bottom: 1px solid #000; }
.row { display: grid; grid-template-columns: 1fr auto 1fr; font-weight: bold; margin-top: 4px; }
.row > :nth-child(2) { text-align: center; }
.row > :last-child { text-align: right; }
ul { margin: 1px 0 0; padding-left: 17px; }
li { margin: 0.5px 0; text-align: justify; hyphens: auto; }
li::marker { font-size: 9pt; }
.tech { font-style: italic; }
.skills li { text-align: left; }
</style></head>
<body>

<div class="head">
  <div class="l">{% for x in left_lines %}{% if not loop.first %}<br>{% endif %}{{ x }}{% endfor %}</div>
  <h1>{{ person.name }}</h1>
  <div class="r">
    <a href="mailto:{{ person.email }}">{{ person.email }}</a>
    {%- if person.website %}<br><a href="{{ person.website }}">{{ person.website | replace('https://','') }}</a>{% endif %}
    {%- if person.linkedin %}<br><a href="{{ person.linkedin }}">{{ person.linkedin | replace('https://','') }}</a>{% endif %}
    {%- if person.github %}<br><a href="{{ person.github }}">{{ person.github | replace('https://','') }}</a>{% endif %}
  </div>
</div>

{% for section in sections %}
<h2>{{ section.title }}</h2>
{%- for entry in section.entries %}
<div class="row"><span>{% if entry.left_url %}<a href="{{ entry.left_url }}">{{ entry.left }}</a>{% else %}{{ entry.left }}{% endif %}</span><span>{% if entry.middle_url %}{{ entry.middle_prefix | default('') }}<a href="{{ entry.middle_url }}">{{ entry.middle_link_text }}</a>{{ entry.middle_suffix | default('') }}{% else %}{{ entry.middle | default('') }}{% endif %}</span><span>{{ entry.right | default('') }}</span></div>
<ul>
  {%- for b in entry.bullets %}
  <li>{{ b.text }}{% if b.tech %} <span class="tech">({{ b.tech }})</span>{% endif %}</li>
  {%- endfor %}
</ul>
{%- endfor %}
{%- if section.skills %}
<ul class="skills">
  {%- for s in section.skills %}
  <li><b>{{ s.label }}:</b> {{ s['items'] | join(', ') }}</li>
  {%- endfor %}
</ul>
{%- endif %}
{% endfor %}

</body></html>
